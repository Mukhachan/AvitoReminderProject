# Создайте .env рядом с этим файлом. Никогда не коммитьте реальные секреты.
TELEGRAM_BOT_TOKEN=replace_with_token_from_BotFather

# Telegram идёт через тот же локальный SOCKS5, что и Profi.ru Parser.
# Для обычного прямого подключения оставьте TELEGRAM_PROXY пустым.
TELEGRAM_PROXY=socks5://127.0.0.1:20808
TELEGRAM_PROXY_RDNS=true

DATABASE_PATH=data/avito_reminder.db
SEARCH_INTERVAL_SECONDS=1800
SCHEDULER_POLL_SECONDS=15
SEARCH_RESULT_CACHE_SECONDS=600
SEARCH_SCHEDULE_SPREAD_SECONDS=300
REQUEST_TIMEOUT_SECONDS=25
REQUEST_RETRIES=3
MAX_RESULTS=30
MAX_NOTIFICATIONS_PER_CHECK=5
NOTIFY_INITIAL_RESULTS=true
LOG_LEVEL=INFO

# Chromium создаёт сессию, затем выдача читается из MFE JSON и JSON-пагинации.
AVITO_TRANSPORT=hybrid
AVITO_HTTP_IMPERSONATE=chrome
AVITO_API_MAX_PAGES=1
# Только при первом наполнении нового поиска можно проверить дополнительные страницы.
AVITO_INITIAL_API_MAX_PAGES=3
AVITO_BROWSER_HEADLESS=true
AVITO_BROWSER_PROFILE_PATH=data/chromium-profile
# При стабильной сессии cookies/storage сохраняются в памяти процесса между проверками.
AVITO_BROWSER_STEALTH=true
# Сохранять наблюдаемые browser/storage-сигналы каждой успешной сессии в diagnostics.
AVITO_BROWSER_SNAPSHOTS=true
AVITO_IDENTITY_ROTATE_ON_BLOCK=true
# true включает холодную новую сессию при каждой проверке; спокойный режим использует false.
AVITO_NEW_USER_PER_SESSION=false
# Спокойный режим сохраняет identity при обычных перезапусках и меняет её после блокировки.
AVITO_IDENTITY_ROTATE_ON_BROWSER_START=false
AVITO_BROWSER_LOCALE=ru-RU
AVITO_BROWSER_TIMEZONE=Europe/Moscow
AVITO_MIN_REQUEST_INTERVAL_SECONDS=120
AVITO_REQUEST_JITTER_SECONDS=120
AVITO_REQUEST_WINDOW_SECONDS=900
AVITO_MAX_REQUESTS_PER_WINDOW=8
AVITO_RATE_LIMIT_COOLDOWN_SECONDS=3600
AVITO_IP_QUARANTINE_SECONDS=21600
AVITO_PAGE_RELOAD_DELAY_SECONDS=90
AVITO_PAGE_RELOAD_JITTER_SECONDS=30
# После серии неудач — общая пауза Avito на 6 часов.
AVITO_ERROR_RELOAD_ATTEMPTS=3
AVITO_COOLDOWN_SECONDS=21600
# Обычно путь определяется автоматически: /usr/bin/chromium
# AVITO_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Маршрут Avito:
# direct   — всегда обычный IP Raspberry Pi;
# fallback — обычный IP, после блокировки переход в пул;
# proxy    — сразу случайный IP из AVITO_PROXY_POOL_FILE, без прямого подключения.
AVITO_PROXY_MODE=direct
AVITO_PROXY=
AVITO_PROXY_RDNS=true

# Ротация внешних IP после подтверждённой блокировки Avito.
# Скопируйте avito_proxies.example.txt в data/avito_proxies.txt, заполните его и включите:
# AVITO_PROXY_MODE=fallback
# Для запуска сразу через пул используйте AVITO_PROXY_MODE=proxy.
# AVITO_PROXY_POOL_FILE=data/avito_proxies.txt
# AVITO_PROXY_ROTATION_ENABLED=true
# AVITO_PROXY_ROTATE_AFTER_RELOADS=1
# AVITO_PROXY_ROTATION_DELAY_SECONDS=15
# AVITO_PROXY_MAX_ROTATIONS=1
# При аварийном или штатном перезапуске Chromium выбрать следующий proxy/IP.
AVITO_PROXY_ROTATE_ON_BROWSER_START=false
# Логировать публичный IP после запуска и каждой ротации Chromium.
AVITO_LOG_PUBLIC_IP=true
# Необязательно для провайдеров с отдельной ссылкой смены IP:
# AVITO_PROXY_CHANGE_URL=https://provider.example/change-ip-secret
# Для одного ручного резервного маршрута: mode=fallback и URL в AVITO_PROXY.
# Необязательно: начальные cookies для старого AVITO_TRANSPORT=http.
# AVITO_COOKIE=
# User-Agent входит в сохраняемую browser identity. После его изменения identity обновится.
# AVITO_USER_AGENT=Mozilla/5.0 ...
