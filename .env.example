# Создайте .env рядом с этим файлом. Никогда не коммитьте реальные секреты.
TELEGRAM_BOT_TOKEN=replace_with_token_from_BotFather

# Telegram идёт через тот же локальный SOCKS5, что и Profi.ru Parser.
# Для обычного прямого подключения оставьте TELEGRAM_PROXY пустым.
TELEGRAM_PROXY=socks5://127.0.0.1:20808
TELEGRAM_PROXY_RDNS=true

DATABASE_PATH=data/avito_reminder.db
SEARCH_INTERVAL_SECONDS=900
SCHEDULER_POLL_SECONDS=15
REQUEST_TIMEOUT_SECONDS=25
REQUEST_RETRIES=3
MAX_RESULTS=30
MAX_NOTIFICATIONS_PER_CHECK=5
NOTIFY_INITIAL_RESULTS=true
LOG_LEVEL=INFO

# Основной транспорт Avito — установленный Chromium Raspberry Pi без прокси.
AVITO_TRANSPORT=browser
AVITO_BROWSER_HEADLESS=true
AVITO_BROWSER_PROFILE_PATH=data/chromium-profile
AVITO_MIN_REQUEST_INTERVAL_SECONDS=60
AVITO_REQUEST_JITTER_SECONDS=30
# Обычно путь определяется автоматически: /usr/bin/chromium
# AVITO_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Avito всегда идёт напрямую; через SOCKS работает только Telegram.
AVITO_PROXY_MODE=direct
AVITO_PROXY=
AVITO_PROXY_RDNS=true
# Для ручного резервного маршрута: mode=fallback и адрес SOCKS в AVITO_PROXY.
# AVITO_COOKIE=
# AVITO_USER_AGENT=Mozilla/5.0 ...
